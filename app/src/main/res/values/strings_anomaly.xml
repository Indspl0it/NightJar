<?xml version="1.0" encoding="utf-8"?>
<!--
  Anomaly names and the detail rows for the IPC version 2 event fields. Text follows the copy standard
  (ASD-STE100). One name for each AnomalyCode, wording from testdata/scenarios.json
  anomalyNames. The names are lower case so that a title can put one after a colon ("Malformed SMS: address cut off").
  Key: anomaly_name_ + the AnomalyCode enum name in lower case. AnomalyNames.kt maps the codes to these keys.
-->
