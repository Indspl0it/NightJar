<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups are allowed so tools like Swift Backup and
  phone-to-phone transfer can carry NightJar to a new ROM. Nothing goes to Google's cloud.
  Device-to-device transfer has no exclude rule, so it copies the message database, which contains message text,
  to the new phone. This is intended.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
